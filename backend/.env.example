# Copy to .env and fill in as needed. All keys are OPTIONAL — the app runs fully
# on free, keyless sources (SEC EDGAR + Yahoo Finance). Keys only enable extra
# providers / higher limits (PRD 02).

# SEC requires a descriptive User-Agent with your contact email.
SEC_USER_AGENT="Financial Atlas you@example.com"

# Database: SQLite locally (default); set a Postgres URL on Render (PRD 30).
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/atlas

# Optional provider keys (leave blank to keep those providers disabled).
FMP_API_KEY=
FINNHUB_API_KEY=
OPENAI_API_KEY=

# Atlas Research uses the Responses API through bounded, typed data tools. The
# cap is cumulative for this deployment, is stored in the application database,
# and blocks a request before it can exceed the remaining allowance. Keep
# production in `production`; `qa` draws from both the QA sub-cap and global cap.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_INPUT_USD_PER_MILLION=2.0
OPENAI_CACHED_INPUT_USD_PER_MILLION=0.2
OPENAI_OUTPUT_USD_PER_MILLION=12.0
OPENAI_GLOBAL_BUDGET_USD=25.0
OPENAI_QA_BUDGET_USD=10.0
OPENAI_USAGE_MODE=production
OPENAI_MAX_OUTPUT_TOKENS=3000
OPENAI_MAX_TOOL_ROUNDS=6
OPENAI_TIMEOUT_SECONDS=45

LOG_LEVEL=info
ENV=local
